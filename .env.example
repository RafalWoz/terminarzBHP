# GUS API - konfiguracja serwera PHP
# Zalecane: plik regon_config.php obok regon_proxy.php (wgrany przez FTP)
# Alternatywa: zmienne srodowiskowe ponizej (panel hostingu lub .htaccess SetEnv)
#
# GUS_ENV=prod
# GUS_API_KEY=your-key-from-api.stat.gov.pl

# Portal / n8n
# Ustaw te sama wartosc w n8n w naglowku Authorization: Bearer <token>
# N8N_API_TOKEN=change-me-to-a-long-random-token
