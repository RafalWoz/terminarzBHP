# GUS API - konfiguracja serwera PHP
# Zalecane: plik regon_config.php obok regon_proxy.php (wgrany przez FTP)
# Alternatywa: zmienne srodowiskowe ponizej (panel hostingu lub .htaccess SetEnv)
#
# GUS_ENV=prod
# GUS_API_KEY=your-key-from-api.stat.gov.pl

# Portal statyczny / n8n
# Przy hostingu statycznym LH.pl n8n powinien dodawac pliki JSON do terminybhp-portal/data/posts,
# a potem uruchomic build i upload folderu terminybhp-portal/out.
#
# N8N_API_TOKEN jest potrzebny tylko wtedy, gdy ponownie wlaczysz endpoint API.
# N8N_API_TOKEN=change-me-to-a-long-random-token
